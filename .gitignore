# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / secrets
.env
.env.*
!.env.example
secrets/

# Logs
logs/
*.log

# Local runtime and diagnostic artifacts. Persistent runtime state belongs in an
# operator-selected volume via AIRLOCK_STATE_DIR, never in the source checkout.
state/
coverage.xml
oom-profile-*.bin

# Transient local Codex agent coordination state.
.agents/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# LiteLLM
litellm_uuid.txt

# Aural

.wake/*
!.wake/shared/
*.pyc
*.pyo
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.claude/worktrees/
site/

# Smoke-test isolated runtime (copied config/.env, test state) — never commit
dev/smoketest/.runtime/

# ``config.local.yaml`` is tracked as an empty fallback so the committed
# ``config.yaml`` include works on a fresh checkout. Local MCP overrides remain
# uncommitted working-tree changes.

# Generated runtime config — proxy.py writes this temp file (config.yaml + env
# overrides + model_info) for LiteLLM and normally deletes it on shutdown; a hard
# kill can leave one behind. Never commit it.
airlock-runtime-*.yaml

# Local agent/tooling state (machine-specific; contains absolute paths) — 0.5.4
.wake/shared/coreyt.jsonl
agents/.aural/

# Benchmark corpora — third-party datasets, not redistributed by Airlock.
# See dev/corpora/README.md for provenance and licenses.
data/
.coverage
